{
  "name": "architecture-guard",
  "version": "2.2.1",
  "description": "SDD-tool-agnostic architecture governance orchestrator for Spec Kit, OpenSpec, and generic Markdown workflows. Detects the active SDD tool and applies the matching adapter automatically.",
  "bin": {
    "architecture-guard": "./dist/bin/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test dist/install.test.js",
    "lint": "eslint .",
    "prepublishOnly": "npm run lint && npm run build && node --test dist/install.test.js"
  },
  "keywords": [
    "sdd",
    "architecture",
    "governance",
    "spec-kit",
    "openspec",
    "spec-driven",
    "ai-agent",
    "architecture-review",
    "ponytail",
    "orchestration"
  ],
  "license": "MIT",
  "author": "DyanGalih",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DyanGalih/spec-kit-architecture-guard.git"
  },
  "homepage": "https://github.com/DyanGalih/spec-kit-architecture-guard",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist/",
    "adapters/",
    "orchestration/",
    "templates/",
    "presets/",
    "hygiene-rules/",
    "sonar-rules/",
    "commands/",
    "README.md",
    "docs/",
    "examples/",
    "LICENSE",
    "ADAPTERS.md",
    "OPENSPEC-INTEGRATION.md",
    "SPECKIT-INTEGRATION.md"
  ],
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0"
  },
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee"
}
